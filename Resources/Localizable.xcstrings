          }
        }
      }
    },
    "O CRC32 não confere (esperado %@, obtido %@). Apague o arquivo e baixe novamente.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CRC32 does not match (expected %@, got %@). Delete the file and download again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "O CRC32 não confere (esperado %1$@, obtido %2$@). Apague o arquivo e baixe novamente."
          }
        }
      }
    },
    "O FirmDrop %@ é a versão mais nova disponível.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FirmDrop %@ is the newest version available."
          }
        }
