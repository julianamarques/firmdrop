    "Detectar consulta o USB. Testar conexão abre uma sessão do protocolo sem gravar partições. O suporte ao S25 ainda precisa ser validado com um aparelho real.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detect queries USB. Test connection opens a protocol session without writing partitions. S25 support still needs validation with a real device."
          }
        }
      }
    },
    "Digite o modelo do aparelho (Configurações › Sobre o telefone), por exemplo SM-A556E ou SM-S928B.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the device model (Settings › About phone), for example SM-A556E or SM-S928B."
          }
        }
      }
    },
